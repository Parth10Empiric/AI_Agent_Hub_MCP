# Copy to .env and fill in. NEVER commit .env - it is gitignored.
#
#   cp .env.example .env

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
MCP_APP_NAME=Personal MCP Server
MCP_ENVIRONMENT=development
MCP_LOG_LEVEL=INFO

# ---------------------------------------------------------
# Plugin credentials (Phase 1 - single-tenant for now)
# ---------------------------------------------------------
# Phase 5 moves these into the per-user plugin_connections table.
GITHUB_TOKEN=
SLACK_BOT_TOKEN=

# Paths are resolved against the project root by
# config.settings.resolve_path(), so relative values are safe.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# ---------------------------------------------------------
# Agent
# ---------------------------------------------------------
OLLAMA_MODEL=minimax-m3:cloud

# ---------------------------------------------------------
# Phase 3 - Backend
# ---------------------------------------------------------
# Must use +asyncpg. Plain postgresql:// picks the SYNCHRONOUS driver,
# which blocks the event loop and serialises every user.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/agenthub

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts plugin_connections.credentials_enc. Losing or rotating this
# key makes every stored OAuth token permanently unreadable.
CREDENTIAL_ENCRYPTION_KEY=

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ---------------------------------------------------------
# Phase 6.2 - Redis
# ---------------------------------------------------------
# Not used by the code yet - Phase 6.4 moves the rate limiter and the
# approval notifier onto it. docker-compose.yml already starts a Redis
# and overrides this to redis://redis:6379/0, so the only reason to set
# it here is a Redis running somewhere else.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------
# Phase 6.2 - Docker
# ---------------------------------------------------------
# `docker compose up` OVERRIDES three of the values in this file,
# because a container's idea of "localhost" is itself:
#
#   DATABASE_URL -> postgresql+asyncpg://postgres:postgres@postgres:5432/agenthub
#   REDIS_URL    -> redis://redis:6379/0
#   OLLAMA_HOST  -> http://host.docker.internal:11434
#
# Ollama is NOT a compose service. It stays on your host - it holds
# multi-gigabyte models and needs your GPU - and the API reaches back
# out to it through the host-gateway mapping in docker-compose.yml.
#
# So: `ollama serve` must be running on the host before
# `docker compose up`, exactly as it does today.

# ---------------------------------------------------------
# Phase 5.2 - Approvals
# ---------------------------------------------------------
# How long a tool call may wait for a human before it is DENIED.
# Silence is never consent, so this is a ceiling, not a target.
#
# NOTE: run ONE uvicorn worker until Redis arrives in Phase 6. The
# wakeup events live in one process's memory, so an approval resolved
# on a different worker never reaches the turn that is waiting - it
# simply times out, with nothing in the logs to say why.
APPROVAL_TIMEOUT_SECONDS=300

# ---------------------------------------------------------
# Phase 5.3 - OAuth
# ---------------------------------------------------------
# Where providers send the browser back. MUST match what is registered
# with each provider, character for character, and is never taken from
# a request - a user-supplied redirect_uri is how authorization codes
# get delivered to an attacker.
OAUTH_REDIRECT_BASE=http://localhost:3000

# Where the callback sends the user once the connection is stored.
FRONTEND_BASE_URL=http://localhost:3000

# How long an in-flight authorisation may take, and how early a token
# is refreshed before it actually expires.
OAUTH_STATE_TTL_SECONDS=600
OAUTH_REFRESH_SKEW_SECONDS=300

# Leave a client id empty to disable that flow. The UI then hides the
# button and offers the paste-a-token dialog instead, rather than
# sending someone to a consent screen that cannot work.
#
# GitHub:  Settings > Developer settings > OAuth Apps
#          Authorization callback URL:
#          http://localhost:3000/api/plugins/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google (Drive AND Calendar share one client):
#   console.cloud.google.com > APIs & Services > Credentials
#   Authorised redirect URIs - BOTH of these:
#     http://localhost:3000/api/plugins/google_drive/oauth/callback
#     http://localhost:3000/api/plugins/google_calendar/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack: api.slack.com/apps > OAuth & Permissions
#        http://localhost:3000/api/plugins/slack/oauth/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---------------------------------------------------------
# Phase 5.4 - Key rotation
# ---------------------------------------------------------
# Comma-separated, NEWEST FIRST. Overrides the singular setting above.
# Leave it unset for normal operation - it exists for rotations.
#
# To rotate the key without downtime and without asking anyone to
# reconnect:
#
#   1. generate a new key
#   2. set CREDENTIAL_ENCRYPTION_KEYS=<new>,<old> and deploy
#         both keys read; new writes use <new>
#   3. python scripts/rotate_credentials.py --apply
#         re-encrypts every row, in batches
#   4. set CREDENTIAL_ENCRYPTION_KEYS=<new> and deploy
#
# Step 4 before step 3 finishes is the one mistake that loses data:
# rows still on the old key become permanently undecryptable.
#
# Verify at any point with: python scripts/check_secrets.py
# CREDENTIAL_ENCRYPTION_KEYS=

# ---------------------------------------------------------
# Phase 5.5 - Multi-tenant MCP
# ---------------------------------------------------------
# In production, a tool call that arrives with no credentials is
# REFUSED. In development it falls back to the tokens above, which is
# what keeps ai_client.py, test_github.py and the local loop working.
#
# That fallback is the single most dangerous setting in this file. Left
# on in production, a user who never connected GitHub silently gets
# YOUR GitHub account - which is the exact bug Phase 5.5 exists to
# remove, reintroduced through the back door.
MCP_ENVIRONMENT=development

# Force the fallback on regardless of environment. Only for a
# single-user self-hosted deployment, where there is no second tenant
# to leak to.
# MCP_ALLOW_ENV_CREDENTIALS=false

# ---------------------------------------------------------
# Phase 5.7 - Rate limits
# ---------------------------------------------------------
# Two independent reasons for these:
#   COST          every turn is model tokens plus API calls
#   BLAST RADIUS  a compromised agent gets one hour's worth
#
# Off switch, for local development and for the moment a limit turns
# out to be wrong in production. A limiter you cannot disable is a
# limiter nobody dares tune.
RATE_LIMIT_ENABLED=true

# Unauthenticated - the only limit a stranger can reach. Keyed on the
# IP *and* the account, because behind a proxy every user shares one
# address and one attacker would otherwise lock out everybody.
LOGIN_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Cost, per user.
API_REQUESTS_PER_MINUTE=100
AGENT_TURNS_PER_HOUR=30
TOOL_CALLS_PER_HOUR=300

# Blast radius, per AGENT - the unit a user configures, and the unit
# that gets compromised.
WRITE_OPS_PER_HOUR=50

# Tighter, and on a different axis: RISK, not operation. Covers HIGH
# and CRITICAL, so it catches google_drive_create_permission (ADMIN,
# HIGH) and slack_send_message (WRITE, HIGH) - neither of which a
# limit keyed on "critical" alone would touch.
DANGEROUS_OPS_PER_HOUR=5

# ---------------------------------------------------------
# Going to production
# ---------------------------------------------------------
# Run this before you deploy - it checks every Phase 5 control at once,
# because the dangerous state is "four are on and the fifth is not":
#
#   python scripts/check_production.py
#   python scripts/check_secrets.py
#
# And run ONE uvicorn worker. Both the approval notifier and the rate
# limiter keep state in a single process's memory, so N workers means
# N times the limits and approvals that time out on the wrong worker.

# ---------------------------------------------------------
# Phase 5.8 - Audit log
# ---------------------------------------------------------
# The audit log is append-only, and that rule lives in the DATABASE,
# not the application - because a rule the app imposes on itself is a
# rule an SQL injection in the app does not have to obey.
#
#   python scripts/setup_db_roles.py --check
#   python scripts/setup_db_roles.py --apply --password '<strong>'
#
# That creates `agenthub_app`, which can INSERT and SELECT audit_log
# but NOT update or delete it. Then, IN THIS ORDER:
#
#   1. ALEMBIC_DATABASE_URL  = the current owner URL (migrations,
#                              retention - both need to delete)
#   2. DATABASE_URL          = the same URL as agenthub_app
#
# Step 1 first, or `alembic upgrade` starts failing with permission
# errors that look like a broken migration.
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/agenthub

# Retention: 12 months MINIMUM, so the job trims at 400 days rather
# than 365 - a job that trims to exactly a year leaves you
# non-compliant the moment it runs late.
#
#   python scripts/purge_audit.py --apply
