# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# end-to-end test build output
/.next-e2e

# testing artifacts (Phase 5.9)
#
# Playwright traces are a full recording of every page snapshot and
# every form fill - including the "Access token" field on the connect
# dialog. Today the committed ones contain ghp_e2e_fake_token_value,
# which is harmless. The day somebody runs the suite against a real
# account to check something, the trace records the real value and
# `git add .` puts it in history permanently.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# build output from the e2e/verify runs
/.next-verify/
/.next-e2e/

# the documentation capture (npm run capture)
#
# Its own production build, and Playwright's per-test artefacts. The
# images it produces are NOT here - those go to ../docs/media and are
# committed, because the READMEs embed them.
/.next-demo/
/tests/demo/.output/
